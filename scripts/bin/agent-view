#!/usr/bin/env bash

set -euo pipefail

output="$(agent-state list 2>/dev/null || true)"

if [[ -z "$output" || "$output" == "No agents" ]]; then
	echo "No agents"
	exit 0
fi

printf '%s\n' "$output" |
	fzf \
		--ansi \
		--no-sort \
		--delimiter $'\t' \
		--tabstop 1 \
		--border-label '🤖 Agents ' \
		--prompt '🤖  ' \
		--header '^x kill pane' \
		--with-nth '1..7' \
		--preview 'tmux capture-pane -e -p -t {8} 2>/dev/null || sesh preview {4}' \
		--preview-window 'right:50%' \
		--bind 'enter:become(agent-state connect-pane {4} {8})' \
		--bind 'ctrl-x:execute(tmux kill-pane -t {8}; agent-state prune)' || true
