#!/usr/bin/env bash

# Git worktree manager - both interactive and CLI modes
# Usage:
#   worktree                         # Interactive UI
#   worktree add <branch>            # Add worktree
#   worktree add <branch> --base <b> # Add worktree from specific base branch
#   worktree remove <path>           # Remove worktree
#   worktree prune                   # Prune stale worktree entries
#   worktree gc [--dry-run|--yes]    # Remove merged, clean, agent-free worktrees
#   worktree list                    # List worktrees (for scripting)
#   worktree switch <branch>         # Connect to existing worktree by branch name
#   worktree switch -c <branch>      # Create worktree and connect

set -euo pipefail

usage() {
	cat <<EOF
Usage: worktree [COMMAND] [ARGS]

Commands:
    (no args)                  Open interactive worktree manager
    add <branch>               Create new worktree for branch
    add <branch> --base <b>    Create worktree from specific base branch
    remove <path>              Remove worktree at path (fails if dirty)
    remove <path> --force      Remove worktree discarding uncommitted changes
    prune                      Prune stale worktree admin entries
    gc [--dry-run] [--yes]     Remove clean worktrees whose branch is merged or
       [--no-fetch]            deleted upstream and has no agent running in it
    list                    List worktrees (paths only, for scripting)
    switch <branch>            Connect to existing worktree by branch name
    switch -c <branch>         Create worktree and connect
    -h, --help                 Show this help

Examples:
    worktree
    worktree add feature-login
    worktree add feature-login --base develop
    worktree remove /path/to/worktree
    worktree list | xargs -I{} git -C {} status
    worktree switch feature-login
    worktree switch -c feature-login
EOF
}

check_git_repo() {
	git rev-parse --git-dir >/dev/null 2>&1
}

require_git_repo() {
	check_git_repo || { echo "Error: Not a git repository"; exit 1; }
}

connect_worktree() {
	local target_path="$1"
	local current_path
	current_path=$(tmux display-message -p '#{session_path}' 2>/dev/null || true)
	if [[ "$target_path" != "$current_path" ]]; then sesh connect "$target_path"; fi
}

get_repo_root() {
	git worktree list | head -1 | awk '{print $1}'
}

get_default_branch() {
	local repo_root="$1"
	local ref
	if ref=$(git -C "$repo_root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null); then
		echo "${ref##refs/remotes/origin/}"
	else
		echo "main"
	fi
}

prune_worktrees() {
	local repo_root
	repo_root=$(get_repo_root)
	local output
	output=$(git -C "$repo_root" worktree prune -v 2>&1)
	if [[ -n "$output" ]]; then
		echo "$output"
	else
		echo "Nothing to prune"
	fi
}

cleanup_after_remove() {
	local repo_root="$1" branch="$2"
	git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
	[[ -n "$branch" ]] && delete_if_merged "$repo_root" "$branch"
	tmux-clean >/dev/null 2>&1 || true
}

# Print how branch landed in base: "merged" (branch is an ancestor of base),
# "squashed" (an equivalent single patch is in base), or nothing.
# Uses merge-base/cherry instead of `git checkout` so it never touches
# repo_root's currently checked-out branch: https://github.com/not-an-aardvark/git-delete-squashed
merge_state() {
	local repo_root="$1" base="$2" branch="$3"
	if git -C "$repo_root" merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then
		echo "merged"
		return 0
	fi

	local merge_base tree commit cherry
	merge_base=$(git -C "$repo_root" merge-base "$base" "$branch" 2>/dev/null) || return 0
	tree=$(git -C "$repo_root" rev-parse "$branch^{tree}" 2>/dev/null) || return 0
	commit=$(git -C "$repo_root" commit-tree "$tree" -p "$merge_base" -m _ 2>/dev/null) || return 0
	cherry=$(git -C "$repo_root" cherry "$base" "$commit" 2>/dev/null)
	[[ "$cherry" == -* ]] && echo "squashed"
	return 0
}

# Delete branch if merged (directly or via squash) into the default branch.
delete_if_merged() {
	local repo_root="$1" branch="$2"
	local default_branch
	default_branch=$(get_default_branch "$repo_root")
	[[ "$branch" == "$default_branch" ]] && return 0

	case "$(merge_state "$repo_root" "$default_branch" "$branch")" in
	merged) git -C "$repo_root" branch -d "$branch" >/dev/null 2>&1 || true ;;
	squashed) git -C "$repo_root" branch -D "$branch" >/dev/null 2>&1 || true ;;
	esac
	return 0
}

# Print #{pane_current_path} for every tmux pane with an agent process running
# beneath it. Process names mirror AGENT_PROCESS_NAMES in agent-state.
agent_pane_paths() {
	command -v tmux >/dev/null || return 0
	awk '
		FILENAME == ARGV[1] {
			p = index($0, " ")
			if (p) path[substr($0, 1, p - 1)] = substr($0, p + 1)
			next
		}
		{
			parent[$1] = $2
			comm = $0
			sub(/^ *[0-9]+ +[0-9]+ +/, "", comm)
			sub(/.*\//, "", comm)
			if (comm == "claude" || comm == "cursor-agent") agents[$1] = 1
		}
		END {
			for (a in agents) {
				pid = a
				for (depth = 0; depth < 64 && pid + 0 > 1; depth++) {
					if (pid in path) { print path[pid]; break }
					pid = parent[pid]
				}
			}
		}
	' <(tmux list-panes -a -F '#{pane_pid} #{pane_current_path}' 2>/dev/null) <(ps -Ao pid=,ppid=,comm=)
}

# Remove worktrees whose work has landed: clean, no agent running in them, and
# branch merged/squash-merged into origin's default branch or deleted upstream.
# Branches are only deleted when merged; upstream-deleted unmerged ones are kept.
gc_worktrees() {
	local dry_run=0 assume_yes=0 fetch=1
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-n | --dry-run) dry_run=1 ;;
		-y | --yes) assume_yes=1 ;;
		--no-fetch) fetch=0 ;;
		*)
			echo "Error: Unknown gc option '$1'"
			return 1
			;;
		esac
		shift
	done

	local repo_root default_branch base
	repo_root=$(get_repo_root)
	default_branch=$(get_default_branch "$repo_root")

	if [[ "$fetch" -eq 1 ]] && git -C "$repo_root" remote get-url origin >/dev/null 2>&1; then
		git -C "$repo_root" fetch --prune --quiet origin 2>/dev/null ||
			echo "Warning: fetch failed, using local refs" >&2
	fi
	base="$default_branch"
	if git -C "$repo_root" rev-parse --verify --quiet "refs/remotes/origin/$default_branch" >/dev/null; then
		base="origin/$default_branch"
	fi

	local gone agent_paths here
	gone=$(git -C "$repo_root" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
		awk '$2 == "[gone]" {print $1}')
	agent_paths=$(agent_pane_paths)
	here=$(pwd -P)

	local -a paths branches flags
	local wt_path="" wt_branch="" wt_flags=""
	while IFS= read -r line; do
		case "$line" in
		worktree\ *) wt_path="${line#worktree }" ;;
		branch\ *) wt_branch="${line#branch refs/heads/}" ;;
		locked* | prunable*) wt_flags+=" ${line%% *}" ;;
		'')
			[[ -n "$wt_path" ]] && paths+=("$wt_path") && branches+=("$wt_branch") && flags+=("$wt_flags")
			wt_path="" wt_branch="" wt_flags=""
			;;
		esac
	done < <(git -C "$repo_root" worktree list --porcelain; echo)

	local -a cand_paths cand_branches cand_reasons cand_delete skipped
	local i p b reason skip state a in_use
	for i in "${!paths[@]}"; do
		p="${paths[$i]}" b="${branches[$i]}" reason="" skip=""
		[[ "$p" == "$repo_root" ]] && continue

		in_use=0
		while IFS= read -r a; do
			[[ -n "$a" && ("$a" == "$p" || "$a" == "$p/"*) ]] && in_use=1
		done <<<"$agent_paths"

		if [[ -z "$b" ]]; then
			skip="detached HEAD"
		elif [[ "$b" == "$default_branch" ]]; then
			skip="default branch"
		elif [[ "${flags[$i]}" == *locked* ]]; then
			skip="locked"
		elif [[ "${flags[$i]}" == *prunable* ]]; then
			skip="directory missing (worktree prune)"
		elif [[ "$here/" == "$p/"* ]]; then
			skip="current directory"
		elif [[ "$in_use" -eq 1 ]]; then
			skip="agent running"
		elif [[ -n "$(git -C "$p" status --porcelain 2>/dev/null)" ]]; then
			skip="uncommitted changes"
		else
			state=$(merge_state "$repo_root" "$base" "$b")
			if [[ "$state" == "merged" ]] &&
				[[ "$(git -C "$repo_root" reflog show --format=%H "refs/heads/$b" 2>/dev/null | wc -l)" -le 1 ]]; then
				# An untouched new branch is trivially an ancestor of base.
				skip="no commits yet"
			elif [[ -n "$state" ]]; then
				reason="$state into $base"
			elif [[ $'\n'"$gone"$'\n' == *$'\n'"$b"$'\n'* ]]; then
				reason="upstream deleted, not merged (branch kept)"
				state=""
			else
				skip="not merged"
			fi
		fi

		if [[ -n "$reason" ]]; then
			cand_paths+=("$p") cand_branches+=("$b") cand_reasons+=("$reason") cand_delete+=("$state")
		else
			skipped+=("$p"$'\t'"[${b:-detached}]"$'\t'"$skip")
		fi
	done

	local -a rows
	for i in "${!cand_paths[@]}"; do
		rows+=("$i"$'\t'"${cand_paths[$i]}"$'\t'"[${cand_branches[$i]}]"$'\t'"${cand_reasons[$i]}")
	done

	if [[ "$dry_run" -eq 1 ]]; then
		echo "Would remove:"
		[[ ${#rows[@]} -eq 0 ]] && echo "  (none)"
		for i in "${!rows[@]}"; do printf '  %s\n' "${rows[$i]#*$'\t'}"; done
		if [[ ${#skipped[@]} -gt 0 ]]; then
			echo "Keeping:"
			for i in "${!skipped[@]}"; do printf '  %s\n' "${skipped[$i]}"; done
		fi
		return 0
	fi

	if [[ ${#rows[@]} -eq 0 ]]; then
		echo "Nothing to clean up"
		return 0
	fi

	local selected
	if [[ "$assume_yes" -eq 1 ]]; then
		selected=$(printf '%s\n' "${rows[@]}")
	elif [[ -t 0 ]]; then
		selected=$(printf '%s\n' "${rows[@]}" | column -t -s $'\t' | fzf \
			--multi \
			--bind 'load:select-all' \
			--layout=reverse \
			--height=~60% \
			--border=rounded \
			--border-label ' 🧹 Worktree GC ' \
			--header 'TAB toggle : ENTER remove selected : ESC cancel' \
			--header-first \
			--with-nth '2..') || {
			echo "Cancelled"
			return 1
		}
	else
		echo "Error: not interactive; pass --yes to remove, or --dry-run to preview"
		return 1
	fi

	local removed=0 idx
	while read -r idx _; do
		[[ -z "$idx" ]] && continue
		p="${cand_paths[$idx]}" b="${cand_branches[$idx]}"
		# No -f: refuse if the worktree picked up changes since it was checked.
		if ! git -C "$repo_root" worktree remove "$p" 2>/dev/null; then
			echo "Error: Failed to remove $p (changed since check?)"
			continue
		fi
		removed=$((removed + 1))
		if [[ -n "${cand_delete[$idx]}" ]] && git -C "$repo_root" branch -D "$b" >/dev/null 2>&1; then
			echo "Removed $p (deleted branch $b)"
		else
			echo "Removed $p (kept branch $b)"
		fi
	done <<<"$selected"

	git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
	[[ "$removed" -gt 0 ]] && { tmux-clean >/dev/null 2>&1 || true; }
	echo "Removed $removed worktree(s)"
}

add_worktree() {
	local branch_name="$1"
	local base_branch="${2:-}"

	if [[ -z "$branch_name" ]]; then
		echo "Error: Branch name cannot be empty"
		return 1
	fi

	# Validate branch name (no spaces or special chars except - _ . /)
	if [[ ! "$branch_name" =~ ^[a-zA-Z0-9/_.-]+$ ]]; then
		echo "Error: Invalid branch name '$branch_name' (use alphanumeric, -, _, ., /)"
		return 1
	fi

	local repo_root
	repo_root=$(get_repo_root)
	local repo_name
	repo_name=$(basename "$repo_root")
	local worktree_path="$(dirname "$repo_root")/$repo_name.$branch_name"

	if [[ -d "$worktree_path" ]]; then
		echo "Error: Worktree already exists at $worktree_path"
		return 1
	fi

	local output
	# Try to create worktree with new branch first
	if [[ -n "$base_branch" ]]; then
		if output=$(git worktree add -b "$branch_name" "$worktree_path" "$base_branch" 2>&1); then
			echo "Created worktree '$branch_name' at $worktree_path (from $base_branch)"
			return 0
		fi
	else
		if output=$(git worktree add -b "$branch_name" "$worktree_path" 2>&1); then
			echo "Created worktree '$branch_name' at $worktree_path"
			return 0
		fi
	fi

	# If branch exists, try using existing branch
	if output=$(git worktree add "$worktree_path" "$branch_name" 2>&1); then
		echo "Created worktree for existing branch '$branch_name' at $worktree_path"
		return 0
	fi

	# Show actual error
	echo "Error: Failed to create worktree '$branch_name'"
	echo "$output" | head -3
	return 1
}

remove_worktree() {
	local worktree_path="$1"
	local force="${2:-}"

	if [[ -z "$worktree_path" ]]; then
		echo "Error: Worktree path cannot be empty"
		return 1
	fi

	local repo_root
	repo_root=$(get_repo_root)

	# Warn if worktree has uncommitted changes and not forcing
	if [[ "$force" != "--force" ]] && [[ -d "$worktree_path" ]]; then
		local dirty
		dirty=$(git -C "$worktree_path" status --porcelain 2>/dev/null || true)
		if [[ -n "$dirty" ]]; then
			echo "Error: Worktree '$worktree_path' has uncommitted changes. Use --force to discard."
			return 1
		fi
	fi

	local branch=""
	[[ -d "$worktree_path" ]] && branch=$(git -C "$worktree_path" branch --show-current 2>/dev/null || true)

	local output
	if output=$(git -C "$repo_root" worktree remove -f "$worktree_path" 2>&1); then
		echo "Removed worktree: $worktree_path"
		cleanup_after_remove "$repo_root" "$branch"
		return 0
	fi

	echo "Error: Failed to remove worktree '$worktree_path'"
	echo "$output" | head -3
	return 1
}

remove_worktree_confirm() {
	local worktree_path="$1"
	if [[ -z "$worktree_path" ]]; then
		echo "Error: Worktree path cannot be empty"
		return 1
	fi

	local branch=""
	[[ -d "$worktree_path" ]] && branch=$(git -C "$worktree_path" branch --show-current 2>/dev/null || true)

	local header="⚠  Force delete: $worktree_path"
	[[ -n "$branch" ]] && header+=$'\n'"   Branch: $branch"
	if [[ -d "$worktree_path" ]] && [[ -n "$(git -C "$worktree_path" status --porcelain 2>/dev/null)" ]]; then
		header+=$'\n'"   Uncommitted changes will be discarded"
	fi

	local choice
	choice=$(printf 'No\nYes\n' | fzf \
		--disabled \
		--layout=reverse \
		--height=~40% \
		--border=rounded \
		--border-label ' Confirm ' \
		--header "$header" \
		--header-first \
		--color 'header:red:bold')

	if [[ "$choice" == "Yes" ]]; then
		remove_worktree "$worktree_path" --force
	else
		echo "Cancelled"
		return 1
	fi
}

list_worktrees() {
	git worktree list --porcelain | awk '/^worktree / {print $2}'
}

list_worktrees_with_status() {
	local repo_root
	repo_root=$(get_repo_root)
	local default_branch
	default_branch=$(get_default_branch "$repo_root")

	local -a paths hashes branches
	local wt_path="" wt_hash="" wt_branch=""
	while IFS= read -r line; do
		case "$line" in
		worktree\ *) wt_path="${line#worktree }" ;;
		HEAD\ *)     wt_hash="${line#HEAD }"; wt_hash="${wt_hash:0:7}" ;;
		branch\ *)   wt_branch="${line#branch refs/heads/}" ;;
		'')
			[[ -n "$wt_path" ]] && paths+=("$wt_path") && hashes+=("$wt_hash") && branches+=("$wt_branch")
			wt_path="" wt_hash="" wt_branch=""
			;;
		esac
	done < <(git -C "$repo_root" worktree list --porcelain)
	[[ -n "$wt_path" ]] && paths+=("$wt_path") && hashes+=("$wt_hash") && branches+=("$wt_branch")

	local max_len=0
	for p in "${paths[@]}"; do
		[[ ${#p} -gt $max_len ]] && max_len=${#p}
	done

	local tmpdir
	tmpdir=$(mktemp -d)

	# Cap concurrent git invocations so a large worktree count doesn't fork-storm the system.
	local max_parallel=12
	local n=0

	for i in "${!paths[@]}"; do
		(
			local wt_path="${paths[$i]}" hash="${hashes[$i]}" branch="${branches[$i]}" indicators=""

			if ! git -C "$wt_path" diff --quiet HEAD 2>/dev/null; then
				indicators+="\033[31m*\033[0m"
			fi

			if [[ -n "$branch" ]]; then
				local counts ahead behind
				counts=$(git -C "$wt_path" rev-list --left-right --count "$branch...origin/$default_branch" 2>/dev/null || echo $'0\t0')
				ahead="${counts%%$'\t'*}"
				behind="${counts##*$'\t'}"
				[[ "$ahead" -gt 0 ]] && indicators+="\033[33m↑${ahead}\033[0m"
				[[ "$behind" -gt 0 ]] && indicators+="\033[36m↓${behind}\033[0m"
			fi

			printf "%-${max_len}s\t\033[33m%s\033[0m  \033[32m[%s]\033[0m %b\n" \
				"$wt_path" "$hash" "${branch:-detached}" "$indicators"
		) >"$tmpdir/$i" &

		if (( ++n % max_parallel == 0 )); then
			wait
		fi
	done
	wait

	for i in "${!paths[@]}"; do cat "$tmpdir/$i"; done
	rm -rf "$tmpdir"
}

switch_worktree() {
	local create=0
	local branch_name=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-c)
			create=1
			shift
			;;
		*)
			branch_name="$1"
			shift
			;;
		esac
	done

	if [[ -z "$branch_name" ]]; then
		echo "Error: Branch name required"
		return 1
	fi

	if [[ "$create" -eq 1 ]]; then
		add_worktree "$branch_name" || return 1
	fi

	local match
	match=$(git worktree list --porcelain |
		awk -v target="$branch_name" '/^worktree / {path=$2} /^branch refs\/heads\// {branch=$2; sub("refs/heads/","",branch); if (branch==target) print path}')

	if [[ -z "$match" ]]; then
		echo "Error: No worktree for branch '$branch_name'"
		return 1
	fi

	connect_worktree "$match"
}

interactive_mode() {
	if ! check_git_repo; then
		return 1
	fi

	local repo_root
	repo_root=$(get_repo_root)
	local default_branch
	default_branch=$(get_default_branch "$repo_root")

	local selected
	selected=$(worktree list-status | fzf \
		--ansi \
		--delimiter $'\t' \
		--border-label '🌴 Worktrees ' \
		--header 'CTRL-X (remove) : CTRL-A (add) : CTRL-G (prune) : ENTER (connect)' \
		--bind "ctrl-x:execute(worktree remove-confirm {1})+reload(cd '$repo_root' && worktree list-status)" \
		--bind "ctrl-a:transform:[[ -n {q} ]] && echo 'reload(worktree add {q} --base $default_branch >/dev/null; cd $repo_root && worktree list-status)' || echo 'bell'" \
		--bind "ctrl-g:execute-silent(worktree prune >/dev/null)+reload(cd '$repo_root' && worktree list-status)" \
		--preview "$(
			cat <<'PREVIEW'
			path={1}
			echo -e '\033[1;36m📍 Worktree:\033[0m '"$path"
			echo

			# Show branch with ahead/behind info
			branch=$(git -C "$path" branch --show-current 2>/dev/null)
			ref=$(git -C "$path" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null) && default="${ref##refs/remotes/origin/}" || default="main"
			if [[ -n "$branch" ]]; then
				ahead=$(git -C "$path" rev-list --count "origin/$default..$branch" 2>/dev/null || echo 0)
				behind=$(git -C "$path" rev-list --count "$branch..origin/$default" 2>/dev/null || echo 0)
				status=""
				[[ "$ahead" -gt 0 ]] && status+="↑$ahead "
				[[ "$behind" -gt 0 ]] && status+="↓$behind"
				echo -e "\033[1;32m🌿 Branch:\033[0m $branch ${status:+\033[1;33m[$status]\033[0m}"
			fi

			# Dirty indicator
			if [[ -n $(git -C "$path" status --porcelain 2>/dev/null) ]]; then
				echo -e '\033[1;31m⚠  Uncommitted changes\033[0m'
			fi
			echo

			echo -e '\033[1;33m📊 Status:\033[0m'
			git -C "$path" -c color.status=always status --short --branch 2>/dev/null
			echo

			echo -e '\033[1;35m📜 Recent Commits:\033[0m'
			git -C "$path" log --oneline --graph --date=short --color=always --pretty='format:%C(auto)%cd %h%d %s' -10 2>/dev/null
PREVIEW
		)") || return 0

	if [[ -n "$selected" ]]; then
		local worktree_path
		worktree_path=$(echo "$selected" | awk '{print $1}')
		connect_worktree "$worktree_path"
	fi
}

main() {
	case "${1:-}" in
	-h | --help)
		usage
		exit 0
		;;
	add)
		require_git_repo
		local branch_name="${2:-}"
		local base_branch=""
		shift 2 2>/dev/null || shift $# 2>/dev/null || true
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--base)
				base_branch="${2:-}"
				shift 2
				;;
			*)
				shift
				;;
			esac
		done
		add_worktree "$branch_name" "$base_branch"
		;;
	remove)
		require_git_repo
		remove_worktree "${2:-}" "${3:-}"
		;;
	remove-confirm)
		require_git_repo
		remove_worktree_confirm "${2:-}"
		;;
	prune)
		require_git_repo
		prune_worktrees
		;;
	gc)
		require_git_repo
		shift
		gc_worktrees "$@"
		;;
	list)
		require_git_repo
		list_worktrees
		;;
	list-status)
		require_git_repo
		list_worktrees_with_status
		;;
	switch)
		require_git_repo
		shift
		switch_worktree "$@"
		;;
	"")
		interactive_mode
		;;
	*)
		echo "Error: Unknown command '$1'"
		echo ""
		usage
		exit 1
		;;
	esac
}

main "$@"
