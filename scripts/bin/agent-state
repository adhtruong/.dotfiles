#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer"]
# ///
"""Track AI agent state per tmux pane. States: working | finished | needs_prompt"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Annotated, Literal, NotRequired, TypedDict

import typer

AgentState = Literal["working", "finished", "needs_prompt"]


class Entry(TypedDict):
    state: AgentState
    tmux_pane: str
    tmux_session: str
    set_at: int
    agent: NotRequired[str]


StateDict = dict[str, Entry]


MARKERS: dict[AgentState, str] = {
    "working": "🤖",
    "finished": "✅",
    "needs_prompt": "💬",
}

MARKER_COLORS: dict[AgentState, str] = {
    "working": "\033[36m",  # cyan
    "finished": "\033[32m",  # green
    "needs_prompt": "\033[33m",  # yellow
}
RESET = "\033[0m"

PRIORITY: dict[AgentState, int] = {
    "needs_prompt": 0,
    "working": 1,
    "finished": 2,
}

# Process name (as reported by `ps -o comm`) each --agent actually runs as.
# Hooks can be skipped on a non-graceful exit (crash, kill -9, dropped
# connection), which would otherwise leave a stale entry pointing at a pane
# that's alive but no longer running the agent. Falls back to the agent name
# itself if not listed here.
AGENT_PROCESS_NAMES: dict[str, str] = {
    "claude": "claude",
    "cursor": "cursor-agent",
}

_xdg = os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))
STATE_FILE = Path(_xdg) / "agent" / "state.json"


def load() -> StateDict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save(state: StateDict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2))
    tmp.rename(STATE_FILE)


def sh(*cmd: str) -> str:
    """Run a command, return stripped stdout, or '' on failure."""
    r = subprocess.run([*cmd], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def entry_key(pane: str, agent: str) -> str:
    return f"{pane}:{agent}" if agent else pane


def pane_path(pane: str) -> str:
    return sh("tmux", "display-message", "-t", pane, "-p", "#{pane_current_path}")


def pane_branch(path: str) -> str:
    return sh("git", "-C", path, "branch", "--show-current") if path else ""


def pane_title(pane: str) -> str:
    return sh("tmux", "display-message", "-t", pane, "-p", "#{pane_title}").replace("\t", " ")


def pane_session(pane: str) -> str:
    return sh("tmux", "display-message", "-t", pane, "-p", "#S")


def git_context() -> str | None:
    """Return TMUX_PANE if the pane is inside a git repo, None otherwise."""
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return None
    path = pane_path(pane)
    return pane if path and pane_branch(path) else None


def age_str(set_at: float) -> str:
    secs = time.time() - set_at
    if secs < 60:
        return f"{int(secs)}s"
    if secs < 3600:
        return f"{int(secs / 60)}m"
    return f"{int(secs / 3600)}h"


def cmd_transition(new_state: AgentState, agent: str = "") -> None:
    """Write a state transition for the current pane."""
    pane = git_context()
    if pane is None:
        return
    state = load()
    entry: Entry = {
        "state": new_state,
        "tmux_pane": pane,
        "tmux_session": pane_session(pane),
        "set_at": int(time.time()),
    }
    if agent:
        entry["agent"] = agent
    state[entry_key(pane, agent)] = entry
    save(state)


def cmd_clear(agent: str = "") -> None:
    pane = git_context()
    if pane is None:
        return
    state = load()
    state.pop(entry_key(pane, agent), None)
    save(state)


def pane_pids() -> dict[str, str]:
    """Map pane_id -> pane_pid, for currently alive panes."""
    lines = sh("tmux", "list-panes", "-a", "-F", "#{pane_id} #{pane_pid}").splitlines()
    return dict(line.split(" ", 1) for line in lines if " " in line)


def process_children() -> dict[str, list[str]]:
    """Map pid -> child pids, from the system process table."""
    children: dict[str, list[str]] = {}
    for line in sh("ps", "-Ao", "pid,ppid").splitlines()[1:]:
        parts = line.split()
        if len(parts) == 2:
            children.setdefault(parts[1], []).append(parts[0])
    return children


def process_names() -> dict[str, str]:
    """Map pid -> comm, from the system process table."""
    names: dict[str, str] = {}
    for line in sh("ps", "-Ao", "pid,comm").splitlines()[1:]:
        parts = line.split(None, 1)
        if len(parts) == 2:
            names[parts[0]] = parts[1].rsplit("/", 1)[-1]
    return names


def agent_running(
    root_pid: str, agent: str, children: dict[str, list[str]], names: dict[str, str]
) -> bool:
    """Check whether a process matching `agent` is running under root_pid."""
    target = AGENT_PROCESS_NAMES.get(agent, agent)
    stack, seen = [root_pid], set()
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        if names.get(pid) == target:
            return True
        stack.extend(children.get(pid, []))
    return False


def cmd_prune() -> None:
    pids = pane_pids()
    children = process_children()
    names = process_names()

    def keep(entry: Entry) -> bool:
        root = pids.get(entry.get("tmux_pane", ""))
        if root is None:
            return False
        agent = entry.get("agent", "")
        return not agent or agent_running(root, agent, children, names)

    state = load()
    save({k: v for k, v in state.items() if keep(v)})


CURRENT_PANE_ICON = "*"


def cmd_list() -> None:
    cmd_prune()
    state = load()
    if not state:
        print("No agents", file=sys.stderr)
        return
    current_pane = os.environ.get("TMUX_PANE", "")
    entries = sorted(state.values(), key=lambda e: PRIORITY.get(e["state"], 99))
    rows = []
    for e in entries:
        pane = e.get("tmux_pane", "")
        path = pane_path(pane)
        rows.append([
            CURRENT_PANE_ICON if pane == current_pane else "",
            MARKERS.get(e["state"], "?"),
            pane_branch(path),
            e.get("tmux_session") or pane_session(pane),
            age_str(e.get("set_at", time.time())),
            e.get("agent", ""),
            pane_title(pane),
            pane,
        ])
    # Pad the fixed-form columns for display; title/pane are left as-is since
    # title is free text and must stay last-visible so fzf's tab-delimited
    # field indexing (used by agent-view) doesn't shift.
    GAPS = [1, 2, 2, 2, 2, 2]  # indicator column gets a tighter gap
    widths = [max(len(r[i]) for r in rows) for i in range(6)] if rows else []
    for e, r in zip(entries, rows):
        padded = [r[i].ljust(widths[i] + GAPS[i]) for i in range(6)]
        color = MARKER_COLORS.get(e["state"], "")
        padded[1] = f"{color}{padded[1]}{RESET}" if color else padded[1]
        print("\t".join([*padded, r[6], r[7]]))


def cmd_debug() -> None:
    state = load()
    debug_state: dict[str, dict[str, object]] = {}
    for key, entry in state.items():
        pane = entry.get("tmux_pane", "")
        path = pane_path(pane)
        debug_state[key] = {
            **entry,
            "_path": path,
            "_branch": pane_branch(path),
            "_repo": sh("git", "-C", path, "remote", "get-url", "origin") if path else "",
            "_title": pane_title(pane),
        }
    print(json.dumps({"config": {"state_file": str(STATE_FILE)}, "state": debug_state}, indent=2))


def cmd_connect_pane(session: str, pane: str) -> None:
    sh("tmux", "switch-client", "-t", session)
    if pane:
        window = sh("tmux", "display-message", "-t", pane, "-p", "#{window_index}")
        if window:
            sh("tmux", "select-window", "-t", f"{session}:{window}")
        sh("tmux", "select-pane", "-t", pane)


app = typer.Typer(pretty_exceptions_enable=False)

AgentOpt = Annotated[str, typer.Option("--agent")]


@app.command()
def working(agent: AgentOpt = "") -> None:
    cmd_transition("working", agent)


@app.command()
def finished(agent: AgentOpt = "") -> None:
    cmd_transition("finished", agent)


@app.command()
def needs_prompt(agent: AgentOpt = "") -> None:
    cmd_transition("needs_prompt", agent)


@app.command()
def clear(agent: AgentOpt = "") -> None:
    cmd_clear(agent)


@app.command()
def prune() -> None:
    cmd_prune()


@app.command(name="list")
def list_agents() -> None:
    cmd_list()


@app.command()
def debug() -> None:
    cmd_debug()


@app.command()
def connect_pane(session: str, pane: Annotated[str, typer.Argument()] = "") -> None:
    cmd_connect_pane(session, pane)


if __name__ == "__main__":
    app()
